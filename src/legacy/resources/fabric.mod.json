{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["ooTruffle"],
  "environment": "client",
  "entrypoints": {
    "init": [ "com.ootruffle.discordpresence.DiscordPresenceMod" ]
  },
  "mixins": [ "discordpresence.mixins.json" ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "osl-entrypoints": "*",
    "osl-lifecycle-events": "*",
    "java": ">=${java_version}"
  },
  "suggests": {
    "oneconfig": ">=${oneconfig_version}",
    "hypixel-mod-api": "*"
  }
}
